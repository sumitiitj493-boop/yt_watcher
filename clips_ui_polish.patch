diff --git a/frontend/src/App.css b/frontend/src/App.css
index 5d073e5..4e255fb 100644
--- a/frontend/src/App.css
+++ b/frontend/src/App.css
@@ -5083,3 +5083,191 @@ body,
 .clip-picker__dropdown {
 	z-index: 1000;
 }
+
+/* ==========================================================================
+   Clip Studio (creator + saved clips) — polished layout
+   ========================================================================== */
+.clip-creator {
+	display: grid;
+	gap: 16px;
+	border: 1px solid var(--border);
+	border-radius: 18px;
+	padding: 18px;
+	background: var(--surface-muted);
+	animation: page-in 260ms ease both;
+}
+
+.clip-creator__meta {
+	display: flex;
+	gap: 8px;
+	flex-wrap: wrap;
+}
+
+.clip-creator__preview {
+	width: 100%;
+	max-height: 340px;
+	border-radius: 14px;
+	background: #000;
+	outline: none;
+	box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
+}
+
+.clip-creator__timeline {
+	display: grid;
+	gap: 10px;
+	padding: 14px;
+	border: 1px dashed var(--border);
+	border-radius: 14px;
+	background: rgba(255, 255, 255, 0.02);
+}
+
+.clip-creator__range-label {
+	display: flex;
+	justify-content: space-between;
+	gap: 10px;
+	flex-wrap: wrap;
+	font-size: 0.85rem;
+	color: var(--text-muted);
+}
+
+.clip-creator__range-label strong {
+	color: var(--text);
+	font-variant-numeric: tabular-nums;
+}
+
+.clip-creator__len {
+	color: var(--accent-cool);
+	font-weight: 800;
+}
+
+.clip-creator__slider-row {
+	display: grid;
+	gap: 10px;
+}
+
+.clip-creator__slider-row input[type='range'] {
+	width: 100%;
+	cursor: pointer;
+	height: 28px;
+}
+
+.clip-creator__time-inputs {
+	display: flex;
+	gap: 20px;
+	flex-wrap: wrap;
+}
+
+.clip-creator__time-inputs label {
+	display: inline-flex;
+	align-items: center;
+	gap: 8px;
+	color: var(--text-muted);
+	font-size: 0.85rem;
+}
+
+.clip-creator__time-inputs .input--num {
+	width: 96px;
+}
+
+.clip-creator__done {
+	color: #34d399;
+	font-weight: 700;
+	background: rgba(52, 211, 153, 0.08);
+	border: 1px solid rgba(52, 211, 153, 0.3);
+	padding: 8px 12px;
+	border-radius: 10px;
+}
+
+/* Saved clip cards */
+.clip-card {
+	width: 100%;
+	display: flex;
+	flex-direction: column;
+	gap: 10px;
+}
+
+.clip-card__head {
+	display: flex;
+	align-items: flex-start;
+	justify-content: space-between;
+	gap: 12px;
+}
+
+.clip-card__title {
+	display: flex;
+	flex-direction: column;
+	gap: 3px;
+	min-width: 0;
+}
+
+.clip-card__actions {
+	display: flex;
+	gap: 4px;
+	flex-shrink: 0;
+}
+
+.clip-card__player {
+	width: 100%;
+	max-height: 320px;
+	border-radius: 12px;
+	background: #000;
+}
+
+/* Creator panel sits above the list for dropdown layering */
+.panel--form:has(.clip-picker) {
+	position: relative;
+	z-index: 30;
+}
+
+.clip-picker__dropdown {
+	z-index: 1000;
+}
+
+/* Clip Studio — extra polish */
+.clip-creator__preview-wrap {
+	position: relative;
+	width: 100%;
+	max-width: 860px;
+	margin: 0 auto;
+}
+
+.clip-creator__preview-wrap video {
+	display: block;
+	width: 100%;
+	max-height: 340px;
+	border-radius: 14px;
+	background: #000;
+	object-fit: contain;
+}
+
+.clip-creator__preview-time {
+	position: absolute;
+	bottom: 10px;
+	right: 10px;
+	background: rgba(0, 0, 0, 0.7);
+	color: #fff;
+	font-size: 0.72rem;
+	font-weight: 700;
+	padding: 3px 8px;
+	border-radius: 999px;
+	pointer-events: none;
+}
+
+.clips-grid {
+	display: grid;
+	grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
+	gap: 12px;
+}
+
+.clips-grid .clip-card {
+	border: 1px solid var(--border);
+	border-radius: 16px;
+	padding: 14px;
+	background: var(--surface-muted);
+}
+
+@media (max-width: 640px) {
+	.clips-grid {
+		grid-template-columns: 1fr;
+	}
+}
