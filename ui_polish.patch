+/* ==========================================================================
+   Legendary polish: aurora, transitions, page-in, skeletons, confetti
+   ========================================================================== */
+
+/* Smooth theme switch */
+body,
+.app-shell,
+.sidebar,
+.main-stage,
+.panel,
+.download-card,
+.input,
+.select,
+.textarea,
+.transcript-textarea,
+.search-box {
+	transition: background-color 300ms ease, border-color 300ms ease, color 300ms ease;
+}
+
+/* Animated aurora backdrop (paints behind sidebar/main) */
+.app-shell {
+	position: relative;
+}
+
+.app-shell::before {
+	content: '';
+	position: fixed;
+	inset: -10%;
+	z-index: 0;
+	pointer-events: none;
+	background:
+		radial-gradient(42% 38% at 18% 22%, rgba(139, 92, 246, 0.16), transparent 70%),
+		radial-gradient(36% 34% at 82% 16%, rgba(34, 211, 238, 0.10), transparent 70%),
+		radial-gradient(46% 42% at 68% 88%, rgba(99, 102, 241, 0.14), transparent 70%),
+		radial-gradient(30% 30% at 30% 82%, rgba(236, 72, 153, 0.08), transparent 70%);
+	filter: blur(40px);
+	animation: aurora-drift 26s ease-in-out infinite alternate;
+	will-change: transform;
+}
+
+@keyframes aurora-drift {
+	0%   { transform: translate3d(-2%, -1%, 0) rotate(0deg) scale(1); }
+	50%  { transform: translate3d(2%, 2%, 0) rotate(6deg) scale(1.06); }
+	100% { transform: translate3d(-1%, 3%, 0) rotate(-4deg) scale(1.02); }
+}
+
+.sidebar,
+.main-stage {
+	position: relative;
+	z-index: 1;
+}
+
+/* Page entrance animation */
+.page-shell {
+	animation: page-in 320ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
+}
+
+@keyframes page-in {
+	from { opacity: 0; transform: translateY(10px); }
+	to   { opacity: 1; transform: translateY(0); }
+}
+
+/* Skeleton shimmer */
+.skeleton {
+	position: relative;
+	overflow: hidden;
+	background: var(--surface-muted);
+	border-radius: 14px;
+	min-height: 16px;
+}
+
+.skeleton::after {
+	content: '';
+	position: absolute;
+	inset: 0;
+	transform: translateX(-100%);
+	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
+	animation: shimmer 1.4s infinite;
+}
+
+@keyframes shimmer {
+	100% { transform: translateX(100%); }
+}
+
+.skeleton-card {
+	display: flex;
+	gap: 14px;
+	align-items: center;
+	padding: 14px;
+	border: 1px solid var(--border);
+	border-radius: 16px;
+	background: var(--surface-muted);
+}
+
+.skeleton-thumb {
+	width: 96px;
+	height: 60px;
+	border-radius: 10px;
+	flex-shrink: 0;
+}
+
+.skeleton-lines {
+	display: grid;
+	gap: 10px;
+	flex: 1;
+}
+
+.skeleton-lines .skeleton:nth-child(1) { width: 70%; }
+.skeleton-lines .skeleton:nth-child(2) { width: 45%; }
+.skeleton-lines .skeleton:nth-child(3) { width: 30%; }
+
+/* Confetti burst */
+.confetti-burst {
+	position: fixed;
+	inset: 0;
+	pointer-events: none;
+	z-index: 1600;
+	overflow: hidden;
+}
+
+.confetti-piece {
+	position: absolute;
+	bottom: -12px;
+	width: 8px;
+	height: 14px;
+	border-radius: 2px;
+	animation: confetti-fly var(--dur) cubic-bezier(0.16, 0.84, 0.44, 1) forwards;
+	opacity: 0;
+}
+
+@keyframes confetti-fly {
+	0%   { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 1; }
+	100% { transform: translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(0.7); opacity: 0; }
+}
+
+/* Toast action button (undo etc.) */
+.toast {
+	align-items: center;
+}
+
+.toast__action {
+	background: rgba(255, 255, 255, 0.14);
+	border: 1px solid rgba(255, 255, 255, 0.28);
+	color: #fff;
+	font-family: inherit;
+	font-size: 0.78rem;
+	font-weight: 700;
+	padding: 4px 12px;
+	border-radius: 999px;
+	cursor: pointer;
+	margin-left: 8px;
+	flex-shrink: 0;
+	transition: background 140ms ease, transform 140ms ease;
+}
+
+.toast__action:hover {
+	background: rgba(255, 255, 255, 0.24);
+	transform: scale(1.04);
+}
+
+/* Playlist drag & drop */
+.download-card--dragging {
+	opacity: 0.45;
+	transform: scale(0.99);
+}
+
+.download-card--drop-target {
+	border-color: var(--accent);
+	box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.25);
+}
+
+.download-card {
+	transition: opacity 140ms ease, transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
+}
+
+/* Count-up subtle pulse on change */
+.usage-card__value--bump {
+	animation: value-bump 400ms ease;
+}
+
+@keyframes value-bump {
+	0%   { transform: scale(1); }
+	40%  { transform: scale(1.12); }
+	100% { transform: scale(1); }
+}
