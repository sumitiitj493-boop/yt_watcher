+	font-size: 0.72rem;
+	font-weight: 700;
+	color: var(--text-muted);
+	background: rgba(255, 255, 255, 0.08);
+	border-radius: 999px;
+	padding: 1px 7px;
+}
+
+/* Card grid */
+.saver-card-grid {
+	display: grid;
+	grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
+	gap: 12px;
+}
+
+.saver-card {
+	border: 1px solid var(--border);
+	border-radius: 14px;
+	background: var(--surface-muted);
+	overflow: hidden;
+	display: flex;
+	flex-direction: column;
+	min-height: 150px;
+	transition: border-color 140ms ease, transform 140ms ease;
+}
+
+.saver-card:hover {
+	border-color: var(--accent-strong);
+	transform: translateY(-1px);
+}
+
+.saver-card--expanded {
+	border-color: var(--accent);
+	grid-column: span 1;
+}
+
+@media (min-width: 900px) {
+	.saver-card--expanded {
+		grid-column: span 2;
+	}
+}
+
+.saver-card__head {
+	display: flex;
+	align-items: flex-start;
+	justify-content: space-between;
+	gap: 8px;
+	padding: 10px 12px;
+	border-bottom: 1px dashed var(--border);
+}
+
+.saver-card__title {
+	display: flex;
+	flex-direction: column;
+	gap: 3px;
+	min-width: 0;
+}
+
+.saver-card__title strong {
+	font-size: 0.9rem;
+	line-height: 1.3;
+	display: -webkit-box;
+	-webkit-line-clamp: 2;
+	-webkit-box-orient: vertical;
+	overflow: hidden;
+}
+
+.saver-card__meta {
+	color: var(--text-muted);
+	font-size: 0.74rem;
+	white-space: nowrap;
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+
+.saver-card__actions {
+	display: flex;
+	gap: 2px;
+	flex-shrink: 0;
+}
+
+.saver-card__preview {
+	flex: 1;
+	display: flex;
+	flex-direction: column;
+	gap: 6px;
+	padding: 12px;
+	text-align: left;
+	background: none;
+	border: none;
+	color: var(--text);
+	cursor: pointer;
+	font-family: inherit;
+	font-size: 0.82rem;
+	line-height: 1.5;
+	white-space: pre-wrap;
+	overflow: hidden;
+}
+
+.saver-card__preview:hover {
+	background: rgba(255, 255, 255, 0.03);
+}
+
+.saver-card__more {
+	color: var(--accent-cool);
+	font-size: 0.76rem;
+}
+
+.saver-card__full {
+	white-space: pre-wrap;
+	word-break: break-word;
+	font-family: inherit;
+	font-size: 0.86rem;
+	line-height: 1.55;
+	margin: 0;
+	padding: 12px 14px;
+	max-height: 60vh;
+	overflow-y: auto;
+	color: var(--text);
+}
+
+.saver-card__edit {
+	display: grid;
+	gap: 10px;
+	padding: 12px 14px;
+}
+
+.saver-card__edit .transcript-textarea {
+	min-height: 140px;
+}
