+                </div>
+              ) : (
+                <div className="saver-card-grid">
+                  {filteredSaverItems.map((item) => {
+                    const expanded = saverExpandedId === item.id;
+                    const editing = saverEditingId === item.id;
+                    const previewLines = (item.text || '').split('\n').slice(0, 4).join('\n');
+                    return (
+                      <div key={item.id} className={`saver-card ${expanded ? 'saver-card--expanded' : ''}`}>
+                        <div className="saver-card__head">
+                          <div className="saver-card__title">
+                            <strong>{item.title}</strong>
+                            <span className="saver-card__meta">
+                              {folderLabel(item.folder)} · {item.source === 'youtube' ? 'YouTube auto' : 'Manual'} · {item.line_count} lines
+                            </span>
+                          </div>
+                          <div className="saver-card__actions">
+                            <button className="icon-button" type="button" title="Copy full transcript" onClick={() => handleSaverCopy(item)}>
+                              {saverCopyStatusId === item.id ? <Check size={15} /> : <Copy size={15} />}
+                            </button>
+                            <button className="icon-button" type="button" title="Edit" onClick={() => handleSaverStartEdit(item)}>
+                              <PenLine size={15} />
+                            </button>
+                            <button className="icon-button icon-button--danger" type="button" title="Delete" onClick={() => handleSaverDelete(item.id)}>
+                              <Trash2 size={15} />
+                            </button>
+                          </div>
+                        </div>
+
+                        {editing ? (
+                          <div className="saver-card__edit">
+                            <input className="input" value={saverEditTitle} onChange={(event) => setSaverEditTitle(event.target.value)} maxLength={300} />
+                            <textarea className="transcript-textarea" rows={8} value={saverEditText} onChange={(event) => setSaverEditText(event.target.value)} />
+                            <div className="transcript-actions">
+                              <button className="primary-button" type="button" onClick={handleSaverSaveEdit} disabled={saverSavingEdit}>
+                                {saverSavingEdit ? <Loader2 className="spin" size={16} /> : <Save size={16} />}
+                                Save changes
+                              </button>
+                              <button className="ghost-button" type="button" onClick={() => setSaverEditingId(null)}>
+                                <X size={16} /> Cancel
+                              </button>
+                            </div>
+                          </div>
+                        ) : expanded ? (
+                          <pre className="saver-card__full">{item.text}</pre>
+                        ) : (
+                          <button className="saver-card__preview" type="button" onClick={() => setSaverExpandedId(item.id)} title="Click to read full transcript">
+                            {previewLines}
+                            <span className="saver-card__more">… click to read full</span>
+                          </button>
+                        )}
+                      </div>
+                    );
+                  })}
+                </div>
+              )}
+            </div>
+          </div>
+        </div>
+      ) : null}
     </div>
   );
 }
