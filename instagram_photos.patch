new file mode 100644
index 0000000..ef69bf0
--- /dev/null
+++ b/testing/test_instagram_photos.py
@@ -0,0 +1,67 @@
+"""End-to-end test: download photos from a real Instagram post.
+
+Run from the repo root:
+    python testing/test_instagram_photos.py
+"""
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO_ROOT / "backend"))
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+tmp_dir = Path(tempfile.mkdtemp(prefix="yt_insta_"))
+POST_URL = "https://www.instagram.com/p/DbdjcLvjej6/"
+
+try:
+    import services.files as files_mod
+
+    files_mod.DOWNLOAD_DIR = tmp_dir
+
+    from routes import download as download_routes
+
+    app = FastAPI()
+    app.include_router(download_routes.router, prefix="/api")
+    client = TestClient(app)
+
+    # 1. Invalid URL -> 400
+    resp = client.post("/api/instagram-photos", json={"url": "not-a-url"})
+    assert resp.status_code == 422, resp.text
+    print("[PASS] invalid URL -> 422")
+
+    # 2. Real post -> downloads photos
+    resp = client.post("/api/instagram-photos", json={"url": POST_URL})
+    print("  status:", resp.status_code, "| body:", resp.text[:300])
+    assert resp.status_code == 200, resp.text
+    data = resp.json()
+    assert data["count"] >= 1, data
+    assert len(data["saved"]) == data["count"], data
+    for name in data["saved"]:
+        assert (tmp_dir / name).exists(), name
+        assert (tmp_dir / name).stat().st_size > 1000, name
+    print(f"[PASS] downloaded {data['count']} photo(s): {data['saved']}")
+
+    # 3. Saved files are real JPEGs
+    sample = tmp_dir / data["saved"][0]
+    head = sample.read_bytes()[:3]
+    assert head == b"\xff\xd8\xff", head  # JPEG magic
+    print("[PASS] files are valid JPEG images")
+
+    # 4. Files appear in library listing (image ext supported)
+    from routes import library as library_routes
+
+    app2 = FastAPI()
+    app2.include_router(library_routes.router, prefix="/api")
+    client2 = TestClient(app2)
+    names = [f["filename"] for f in client2.get("/api/files").json()["files"]]
+    for name in data["saved"]:
+        assert name in names, name
+    print("[PASS] photos listed in /api/files (Library)")
+
+    print("\nALL INSTAGRAM PHOTOS TESTS PASSED")
+finally:
+    shutil.rmtree(tmp_dir, ignore_errors=True)
