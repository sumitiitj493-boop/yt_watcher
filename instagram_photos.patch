@@ -0,0 +1,57 @@
+@echo off
+REM ============================================================
+REM  One-click: update yt-dlp to the NIGHTLY build + curl_cffi
+REM
+REM  WHY: Instagram's "empty media response" is a known, ongoing
+REM  yt-dlp bug (even for public posts). The community fix
+REM  (pinned by yt-dlp maintainers) is the NIGHTLY build, plus
+REM  curl_cffi for impersonation.
+REM
+REM  Run this, then restart the backend (start.bat).
+REM ============================================================
+setlocal EnableExtensions
+set "ROOT=%~dp0"
+
+REM --- find the venv python ---
+set "PYTHON="
+if exist "%ROOT%.venv\Scripts\python.exe" set "PYTHON=%ROOT%.venv\Scripts\python.exe"
+if not defined PYTHON if exist "%ROOT%backend\venv\Scripts\python.exe" set "PYTHON=%ROOT%backend\venv\Scripts\python.exe"
+if not defined PYTHON (
+    echo ERROR: No virtualenv found. Run start.bat once first, then try again.
+    pause
+    exit /b 1
+)
+echo Using Python: %PYTHON%
+echo.
+
+echo [1/2] Updating curl_cffi (needed for Instagram impersonation) ...
+"%PYTHON%" -m pip install -U "curl_cffi>=0.15"
+if errorlevel 1 (
+    echo WARNING: curl_cffi update failed - continuing anyway.
+)
+
+echo.
+echo [2/2] Updating yt-dlp to the NIGHTLY build ...
+"%PYTHON%" -m pip install -U "https://github.com/yt-dlp/yt-dlp/archive/refs/heads/master.tar.gz"
+if errorlevel 1 (
+    echo.
+    echo ERROR: yt-dlp nightly update failed. Check your internet connection.
+    pause
+    exit /b 1
+)
+
+echo.
+echo --- Versions now installed ---
+"%PYTHON%" -m pip show yt-dlp curl_cffi 2>nul | findstr /i "Name Version"
+
+echo.
+echo ============================================
+echo  Done! Now:
+echo   1. Close all YT Suite windows.
+echo   2. Run start.bat.
+echo   3. In the app, make sure Instagram cookies
+echo      are set (see the "Instagram login
+echo      cookies" card on the Download page).
+echo ============================================
+echo.
+pause
