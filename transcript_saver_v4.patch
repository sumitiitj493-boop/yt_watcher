+            </button>
+          ))}
+        </div>
+      </section>
+
+      {/* List */}
+      <section className="panel panel--list">
+        <div className="panel__header">
+          <div>
+            <h2 className="panel__title">{activeFolder === 'all' ? 'All transcripts' : folderLabel(activeFolder)}</h2>
+            <p className="panel__subtitle">
