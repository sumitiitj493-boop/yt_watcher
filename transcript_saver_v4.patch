+      notify(err?.response?.data?.detail || 'Unable to update transcript.', 'error');
+    } finally {
+      setSavingEdit(false);
+    }
+  };
+
+  const handleDelete = async (id) => {
+    try {
+      await api.delete(`/transcript-saver/${id}`);
+      if (expandedId === id) setExpandedId(null);
+      if (editingId === id) setEditingId(null);
