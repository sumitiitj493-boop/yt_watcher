+	border: 1px solid var(--border);
+	background: var(--surface-muted);
+	cursor: pointer;
+	transition: border-color 140ms ease, background 140ms ease;
+}
+
+.playlist-pick-row:hover {
+	border-color: var(--accent);
+}
+
+.playlist-pick-row--selected {
+	border-color: var(--accent);
+	background: rgba(124, 58, 237, 0.12);
+}
+
+.playlist-pick-row input[type='radio'] {
+	accent-color: var(--accent);
+	width: 16px;
+	height: 16px;
+	flex: none;
+}
+
+.playlist-pick-row__name {
+	flex: 1;
+	font-weight: 600;
+	white-space: nowrap;
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+
+.playlist-pick-row__count {
+	font-size: 12px;
+	color: var(--text-muted);
+	flex: none;
+}
+
+.playlist-pick-empty {
+	margin: 0;
+	color: var(--text-muted);
+	font-size: 14px;
+	text-align: center;
+	padding: 18px 0;
+}
+
+.playlist-pick-new {
+	display: grid;
+	gap: 10px;
+}
+
+.playlist-pick-new__toggle {
+	display: inline-flex;
+	align-items: center;
+	gap: 8px;
+	align-self: flex-start;
+	padding: 10px 14px;
+	border-radius: 12px;
+	border: 1px dashed var(--border);
+	background: transparent;
+	color: var(--text-muted);
+	font: inherit;
+	font-weight: 600;
+	cursor: pointer;
+	transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
+}
+
+.playlist-pick-new__toggle:hover,
+.playlist-pick-new__toggle--active {
+	border-color: var(--accent);
+	color: var(--text);
+	background: var(--surface-muted);
+}
+
+.form-error {
+	margin: 0;
+	padding: 10px 14px;
+	border-radius: 12px;
+	border: 1px solid rgba(244, 63, 94, 0.4);
+	background: rgba(244, 63, 94, 0.1);
+	color: #f43f5e;
+	font-size: 13px;
+}
+
+@media (max-width: 640px) {
+	.modal-overlay {
+		padding: 12px;
+	}
+
+	.modal-card {
+		max-height: calc(100vh - 24px);
+	}
+}
