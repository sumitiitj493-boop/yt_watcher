+            (index for index, item in enumerate(batch["tasks"]) if item.get("status") != "completed"),
+            0,
+        )
+        batch["next_to_enqueue"] = first_open
+        batch["cancel_requested"] = False
+        batch["phase"] = "running"
+        batch["done"] = False
+    await _ensure_supervisor(batch_id)
+    return True
