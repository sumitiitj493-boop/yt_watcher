+
+async def retry_batch(batch_id: str) -> bool:
+    """Re-queue the failed/cancelled items of a finished or partial batch."""
+    with _LOCK:
+        batch = _BATCHES.get(batch_id)
+        if not batch:
+            return False
+        for item in batch.get("tasks", []):
+            if item.get("status") in ("error", "cancelled"):
+                item["status"] = "planned"
+                item["task_id"] = None
+                item["error"] = None
+                item["percent"] = ""
+                item["progress"] = None
+                item["added"] = False
