diff --git a/frontend/src/App.css b/frontend/src/App.css
index 17a3956..1296bc6 100644
--- a/frontend/src/App.css
+++ b/frontend/src/App.css
@@ -4907,3 +4907,167 @@ body,
 	flex: 1;
 	min-width: 220px;
 }
+
+/* Clip video picker (searchable, folder-organized) */
+.clip-picker {
+	position: relative;
+}
+
+.clip-picker__trigger {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 10px;
+	width: 100%;
+	padding: 11px 14px;
+	border-radius: 14px;
+	border: 1px solid var(--border);
+	background: var(--surface-muted);
+	color: var(--text);
+	font-family: inherit;
+	font-size: 0.92rem;
+	cursor: pointer;
+	text-align: left;
+	transition: border-color 140ms ease, background 140ms ease;
+}
+
+.clip-picker__trigger:hover {
+	border-color: var(--accent-strong);
+}
+
+.clip-picker__trigger-text {
+	flex: 1;
+	min-width: 0;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.clip-picker__trigger-count {
+	font-size: 0.74rem;
+	color: var(--text-muted);
+	background: rgba(255, 255, 255, 0.06);
+	border: 1px solid var(--border);
+	border-radius: 999px;
+	padding: 2px 8px;
+	flex-shrink: 0;
+}
+
+.clip-picker__dropdown {
+	position: absolute;
+	top: calc(100% + 6px);
+	left: 0;
+	right: 0;
+	z-index: 200;
+	background: var(--surface);
+	border: 1px solid var(--border);
+	border-radius: 14px;
+	box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
+	padding: 8px;
+	display: grid;
+	gap: 8px;
+}
+
+.clip-picker__search {
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	border: 1px solid var(--border);
+	border-radius: 10px;
+	padding: 4px 10px;
+	background: var(--surface-muted);
+}
+
+.clip-picker__search-icon {
+	color: var(--text-muted);
+	flex-shrink: 0;
+}
+
+.clip-picker__search input {
+	background: none;
+	border: none;
+	outline: none;
+	color: var(--text);
+	font-family: inherit;
+	font-size: 0.9rem;
+	width: 100%;
+}
+
+.clip-picker__folders {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 6px;
+}
+
+.clip-picker__folder {
+	padding: 4px 10px;
+	border-radius: 999px;
+	border: 1px solid var(--border);
+	background: var(--surface-muted);
+	color: var(--text-muted);
+	font-size: 0.76rem;
+	cursor: pointer;
+	transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
+}
+
+.clip-picker__folder:hover {
+	border-color: var(--accent-strong);
+	color: var(--text);
+}
+
+.clip-picker__folder--active {
+	border-color: var(--accent);
+	background: rgba(124, 58, 237, 0.14);
+	color: var(--text);
+}
+
+.clip-picker__list {
+	max-height: 260px;
+	overflow-y: auto;
+	display: grid;
+	gap: 2px;
+}
+
+.clip-picker__option {
+	display: flex;
+	flex-direction: column;
+	gap: 2px;
+	padding: 8px 10px;
+	border-radius: 10px;
+	border: none;
+	background: none;
+	color: var(--text);
+	font-family: inherit;
+	text-align: left;
+	cursor: pointer;
+}
+
+.clip-picker__option:hover {
+	background: rgba(255, 255, 255, 0.05);
+}
+
+.clip-picker__option--active {
+	background: rgba(124, 58, 237, 0.14);
+}
+
+.clip-picker__option-title {
+	font-size: 0.88rem;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.clip-picker__option-folder {
+	font-size: 0.72rem;
+	color: var(--accent-cool);
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.clip-picker__empty {
+	padding: 16px;
+	text-align: center;
+	color: var(--text-muted);
+	font-size: 0.85rem;
+}
