diff --git a/frontend/src/components/VoiceGreeting.jsx b/frontend/src/components/VoiceGreeting.jsx
new file mode 100644
index 0000000..b5b2da0
--- /dev/null
+++ b/frontend/src/components/VoiceGreeting.jsx
@@ -0,0 +1,93 @@
+import { useEffect, useRef } from 'react';
+
+// Randomly-picked greeting clips. Files live in frontend/public/voices/
+// (delivered alongside the code patch). If a file is missing or playback is
+// blocked, we fall back to the browser's built-in speech synthesis so the
+// greeting still works with zero dependencies.
+const CLIPS = [
+  { lang: 'hi', file: '/voices/hi-1.mp3', text: 'नमस्ते! योट प्राइवेट सूट में आपका स्वागत है। आपकी सारी चीज़ें तैयार हैं, पढ़ाई का आनंद लीजिए!' },
+  { lang: 'hi', file: '/voices/hi-2.mp3', text: 'स्वागत है! आपके डाउनलोड और ट्रांसक्रिप्ट सब सुरक्षित हैं। आज की पढ़ाई के लिए शुभकामनाएँ!' },
+  { lang: 'hi', file: '/voices/hi-3.mp3', text: 'नमस्ते! एक बार फिर आपका स्वागत है। खुश रहिए और मज़े से सीखिए!' },
+  { lang: 'en', file: '/voices/en-1.mp3', text: 'Welcome back to YT Private Suite! Your downloads and transcripts are safe and ready.' },
+  { lang: 'en', file: '/voices/en-2.mp3', text: 'Hello! Great to see you again. Everything is ready for your study session.' },
+  { lang: 'en', file: '/voices/en-3.mp3', text: 'Welcome! Enjoy your downloads, playlists, and transcripts. Happy learning!' },
+];
+
+// Play only once per page load (React StrictMode double-mounts in dev).
+let playedThisLoad = false;
+let currentAudio = null;
+
+function speakFallback(text, lang) {
+  try {
+    if (!('speechSynthesis' in window)) return;
+    window.speechSynthesis.cancel();
+    const utter = new SpeechSynthesisUtterance(text);
+    utter.lang = lang === 'hi' ? 'hi-IN' : 'en-IN';
+    utter.rate = 1;
+    const voices = window.speechSynthesis.getVoices();
+    const match = voices.find((voice) => {
+      const vlang = String(voice.lang || '').toLowerCase();
+      return lang === 'hi' ? vlang.startsWith('hi') : vlang.startsWith('en');
+    });
+    if (match) utter.voice = match;
+    window.speechSynthesis.speak(utter);
+  } catch {
+    // never crash the app over a greeting
+  }
+}
+
+export default function VoiceGreeting({ muted }) {
+  const playedRef = useRef(false);
+
+  useEffect(() => {
+    if (muted) return undefined;
+    if (playedThisLoad || playedRef.current) return undefined;
+    playedThisLoad = true;
+    playedRef.current = true;
+
+    const clip = CLIPS[Math.floor(Math.random() * CLIPS.length)];
+    let fallbackDone = false;
+    const doFallback = () => {
+      if (fallbackDone) return;
+      fallbackDone = true;
+      speakFallback(clip.text, clip.lang);
+    };
+
+    const attempt = () => {
+      const audio = new Audio(clip.file);
+      currentAudio = audio;
+      audio.volume = 1;
+      audio.addEventListener('error', doFallback);
+
+      const playNow = () => {
+        const promise = audio.play();
